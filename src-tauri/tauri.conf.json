{
  "build": {
    "beforeDevCommand": "bash -c 'cd src/backend && go run ./cmd/main.go'",
    "devPath": "http://localhost:3000",
    "distDir": "../src/backend/public",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "PulsarViewer",
    "version": "3.0.19"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "sidecar": true,
        "scope": [
          {
            "name": "../src/backend/pulsarviewer-backend",
            "sidecar": true
          }
        ]
      },
      "process": {
        "all": false,
        "relaunch": true
      }
    },
    "bundle": {
      "active": true,
      "targets": [
        "dmg",
        "app",
        "appimage",
        "msi",
        "updater"
      ],
      "identifier": "com.pulsarviewer.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [
        "../src/backend/pulsarviewer-backend"
      ],
      "resources": [
        "../src/backend/public"
      ]
    },
    "windows": [
      {
        "title": "PulsarViewer",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/jrui/PulsarViewer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MUYxMzg2MDMzQTM5QjAKUldTd09Ub0RoaE1mbDBFdGpod2VPTFdoRHhOYjZwZHRBVXNCdFQyK0FLb0ltcVY4Skg0OFFZNU0K"
    }
  }
}

