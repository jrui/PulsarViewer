# macOS Code Signing (for building signed releases)
# Get these from https://developer.apple.com/account/
# APPLE_ID=your-apple-id@email.com
# APPLE_APP_SPECIFIC_PASSWORD=your-app-specific-password
# APPLE_TEAM_ID=your-team-id
# CSC_LINK=/path/to/your/certificate.p12
# CSC_KEY_PASSPHRASE=your-certificate-password

# Windows Code Signing (optional)
# CSC_LINK=/path/to/your/certificate.pfx
# CSC_KEY_PASSPHRASE=your-certificate-password
